# ============================================================
# RING-HUNTER AI — configuration
# `ring-hunter init` copies this file to ~/.ring-hunter/.env — edit that copy.
# NEVER commit the .env file.
# ============================================================

# --- Network (required) ---
# Public Robinhood Chain mainnet RPC (verified 2026-10-27: eth_chainId = 0x1237).
# You may use a private RPC instead (Alchemy, Chainstack, etc.). Private URLs are never printed to logs.
ROBINHOOD_CHAIN_RPC=https://rpc.mainnet.chain.robinhood.com

# Expected chain ID. The scanner stops if the RPC reports a different chain ID.
ROBINHOOD_CHAIN_ID=4663

# --- AI provider (optional; local analysis mode works without it) ---
# Options: gemini | groq | none
AI_PROVIDER=none

GEMINI_API_KEY=
GROQ_API_KEY=

# The model name MUST match a model available on your account.
# The app never guesses model names.
GEMINI_MODEL=
GROQ_MODEL=

# AI request timeout (ms)
AI_TIMEOUT_MS=30000

# --- Explorer (optional, strongly recommended) ---
# Free API key from https://dev.blockscout.com — used for:
#  - native ETH transfer history (funding graph)
#  - creators of non-Pons tokens
#  - standalone wallet analysis
# Without a key: the funding graph comes from token logs only (status PARTIAL DATA).
BLOCK_EXPLORER_API_KEY=

# --- Account (optional) ---
# URL of the RING-HUNTER website, used only by `ring-hunter login / whoami`. Scanning never needs it.
# Leave empty if you don't use an account.
RING_HUNTER_API_URL=

# --- Scan limits ---
MAX_INITIAL_TRANSACTIONS=50
RPC_TIMEOUT_MS=15000
# Max block range per eth_getLogs (the public RPC caps at 10,000,000 blocks & 10,000 logs)
LOG_CHUNK_BLOCKS=500000
# Total time limit for holder reconstruction (seconds). If exceeded → PARTIAL DATA.
HOLDER_SCAN_MAX_SECONDS=120

# Local web UI port (npm run web). The server only listens on 127.0.0.1.
WEB_PORT=3000
