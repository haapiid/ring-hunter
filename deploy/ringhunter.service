# systemd unit for the RING-HUNTER website + account server.
# Install: cp deploy/ringhunter.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now ringhunter
[Unit]
Description=RING-HUNTER AI website and account server
After=network.target

[Service]
Type=simple
User=ringhunter
Group=ringhunter
WorkingDirectory=/opt/ring-hunter
Environment=NODE_ENV=production
Environment=RH_PUBLIC_ORIGIN=https://www.ringhunter.fun
Environment=RH_SERVER_PORT=8787
Environment=RH_DB_FILE=/var/lib/ringhunter/accounts.db
Environment=RH_TRUST_PROXY=1
# RING-HUNTER Pro settings (RH_TREASURY, RH_PRO_PRICE_ETH, RH_PRO_TOKEN, …) live outside the repo; optional.
EnvironmentFile=-/etc/ringhunter.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=3

# Hardening: the code is read-only; only the database folder is writable.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/ringhunter
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
